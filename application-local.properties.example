# ============================================================
#  Exemple de configuration locale
#  Copiez ce fichier en "application-local.properties"
#  puis modifiez les valeurs. Le fichier copie est ignore par git.
# ============================================================

# --- Base de donnees locale ---
spring.datasource.url=jdbc:h2:file:./data/taxidb
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=

# --- Mot de passe des comptes de demonstration ---
app.demo-data.password=password
